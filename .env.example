# myopenfund-mcp configuration: environment variables only. Copy to .env (never committed) and fill in.
# Each variable is shown commented out with its default: an unset or empty variable takes that default.
# Uncomment only what you change. Keep MOF_MCP_TRANSPORT and MOF_MCP_HOST commented out for the Docker
# image (it sets http and 0.0.0.0 itself). A bad value stops the server at start, naming the variable.

# --- Transport -------------------------------------------------------------------------------------
# stdio (local, one client process, no token) | http (Streamable HTTP, bearer tokens required)
# MOF_MCP_TRANSPORT=stdio
# Interface the HTTP server listens on. Loopback by default; the Docker image sets 0.0.0.0 inside the
# container, and the compose port mapping decides what the host exposes.
# MOF_MCP_HOST=127.0.0.1
# HTTP port (1-65535)
# MOF_MCP_PORT=8000
# HTTP endpoint path (must start with /)
# MOF_MCP_PATH=/mcp

# --- Clients and tiers (http only) ---------------------------------------------------------------
# MOF_MCP_TRANSPORT=http requires MOF_MCP_TOKENS: the HTTP server never runs unauthenticated.
# One entry per client, comma-separated: client:sha256hex[:tier]   (tier read | act, default act)
# Client ids: 1-32 characters of A-Z a-z 0-9 _ . -
# Make each entry with:   myopenfund-mcp hash-token <client> [--tier read|act]
#   (container: docker compose run --rm mcp myopenfund-mcp hash-token <client>)
#   It GENERATES a random 256-bit token: the token is printed on stderr (give it to that client only),
#   the entry alone on stdout (paste it here). Only the digest is stored on the server. To revoke a
#   client, delete its entry and restart.
# Entropy: digests are unsalted SHA-256, safe only for random tokens like these. Never use a passphrase
# or any token you chose yourself (hash-token does not accept one).
# MOF_MCP_TOKENS=<client>:<sha256hex>:act,<other-client>:<sha256hex>:read

# --- Vault toolset (needs the [vault] extra) ------------------------------------------------------
# Unset = no vault toolset (server_info reports it "not configured"). Use the read-only role.
# Set sslmode explicitly (it also avoids a wasted SSL attempt per call):
#   verify-full  preferred: encrypts AND authenticates the server (add sslrootcert=<provider CA file>)
#   require      fallback: encrypts, but does NOT authenticate the server
#   disable      only on a trusted private network (same Docker network, VPN)
# MOF_VAULT_DATABASE_URL=postgresql://vault_readonly:<password>@<host>:5432/documents?sslmode=verify-full
# Seconds before a vault query is cancelled by Postgres (statement_timeout per call; 1-2147483)
# MOF_MCP_QUERY_TIMEOUT_S=20
# Seconds to wait for a Postgres connection (2-300)
# MOF_MCP_CONNECT_TIMEOUT_S=10

# --- Companies and datasets toolsets (needs the [companies] extra) --------------------------------
# Unset = no companies_* / datasets_* toolsets (server_info reports them "not configured"). Both
# MOF_COMPANIES_CATALOG and MOF_COMPANIES_DATA_ROOT must be set together. Use the read-only lake_reader role.
# open-data-store catalogue connection string (kept out of logs and repr)
# MOF_COMPANIES_CATALOG=postgres:dbname=<db> host=<host> port=5432 user=lake_reader password=<password>
# Folder holding lake/ as this host sees it (read-only is enough)
# MOF_COMPANIES_DATA_ROOT=<data-root>
# Seconds before a store call stops waiting (1-3600)
# MOF_COMPANIES_QUERY_TIMEOUT_S=20
# Most companies a single call may name (1-100)
# MOF_COMPANIES_MAX_COMPANIES=10
# Store reads running at once (1-16). A read abandoned at its time budget keeps its slot until it ends,
# so the next callers may also get [timeout] for a while
# MOF_COMPANIES_MAX_CONCURRENCY=2
# How TTM derives a fourth quarter the company did not report on its own: ytd9 = full year minus the
# 9-month year-to-date (the rule of company-corpus's published outputs; a TTM needing a 9-month value the
# store lacks is absent) | sum_of_quarters = full year minus Q1, Q2 and Q3 (present whenever those three
# quarters are, but some differ from company-corpus's)
# MOF_COMPANIES_Q4_RULE=ytd9

# --- Rag toolset (needs the [rag] extra) -----------------------------------------------------------
# Unset = no rag toolset (server_info reports it "not configured"). MOF_RAG_QDRANT_HOST, MOF_RAG_COLLECTION
# and MOF_RAG_MODEL_CACHE must be set together. The engine's own QDRANT_* / RAG_ENGINE_* variables are
# never read by the server.
# Qdrant host name or address ALONE: no scheme, no port (a value such as qdrant:6333 is refused), no path.
# An IPv6 address is given bare or in brackets
# MOF_RAG_QDRANT_HOST=<qdrant-host>
# Qdrant HTTP port (1-65535)
# MOF_RAG_QDRANT_PORT=6333
# Qdrant API key: give a READ-ONLY key, the toolset never writes (kept out of logs, repr and errors)
# MOF_RAG_QDRANT_API_KEY=<read-only-api-key>
# Connect to Qdrant over TLS (true | false). Without TLS the key travels in clear: private network only
# MOF_RAG_QDRANT_HTTPS=false
# Seconds ONE request to Qdrant may take (1-300, at most MOF_RAG_CALL_TIMEOUT_S); a call makes several
# (collection check after a failure, read of the filter values when due, read of the payload schema for
# a date bound in auto mode when due, search). A request that takes
# longer fails, and the call that made it answers [rag_unavailable] qdrant_unreachable
# MOF_RAG_QDRANT_TIMEOUT=10
# Time budget of one rag_search call in seconds, its wait for a free slot included (1-3600, at least
# MOF_RAG_QDRANT_TIMEOUT). At its end the call answers [rag_unavailable]: `timeout` if its search was
# still running, `busy` if it never got a slot
# MOF_RAG_CALL_TIMEOUT_S=15
# Searches running at once (1-64). The calls in excess wait, without taking a thread from the other
# toolsets, and answer [rag_unavailable] busy if no slot frees within their time budget
# MOF_RAG_MAX_CONCURRENCY=4
# Seconds a failed collection check (Qdrant down, key refused, collection missing) is remembered: the
# calls made meanwhile answer [rag_unavailable] at once instead of asking Qdrant again (1-3600). Also
# the longest the toolset takes to notice that Qdrant is back. A failed search is not remembered: it
# only makes the next call run the collection check
# MOF_RAG_CHECK_RETRY_S=5
# Collection searched; it must hold 768-dimension cosine vectors of intfloat/multilingual-e5-base
# MOF_RAG_COLLECTION=<collection>
# Directory holding the embedding model files (about 1.1 GB, pinned and hash-checked at each start):
# an absolute path. Fill it once, then mount it read-only (see README, "Deploying the rag toolset").
# Never a temporary dir. The process needs about 2 GB of memory while the model loads: give a container
# at least 3 GB
# MOF_RAG_MODEL_CACHE=<model-cache-dir>
# Threads of the ONNX runtime (1-256). Unset = one per core of the HOST: in a container with a CPU
# limit, set it to the limit
# MOF_RAG_ONNX_THREADS=<threads>
# Passages returned by rag_search when the caller gives no limit (>= 1, <= MOF_RAG_MAX_LIMIT)
# MOF_RAG_DEFAULT_LIMIT=8
# Largest limit a caller may ask rag_search for; a larger one is refused with [limit_exceeded] (1-1000)
# MOF_RAG_MAX_LIMIT=20
# Seconds the collection's filter values (source codes, doc types, languages) are kept before being read
# again (1-86400). A code ingested since the last read is not refused meanwhile: see the next variable
# MOF_RAG_CODES_TTL_S=300
# Least seconds between two reads of the filter values that the TTL did not ask for: the one made before
# a value is refused (so a code that has just been ingested is accepted), and the retry after a read that
# failed (1-3600)
# MOF_RAG_CODES_RETRY_S=5
# Text appended to the description of rag_search, on one line: what the collection holds and what its
# codes mean (at most 1500 characters; unset = nothing appended). The description itself names no source
# and no document type. A suggested value for the central-bank collection is in the README
# MOF_RAG_DESCRIPTION_NOTES=<notes-on-the-collection>
# How a date bound of rag_search is applied (rag-engine's date_filter_mode; the engine's own
# RAG_ENGINE_DATE_FILTER_* variables are not read):
#   auto      the intervals (date_start..date_end) on a collection where both fields have a datetime
#             index, the date field elsewhere; follows a collection upgraded while the server runs
#   interval  always the intervals (a collection in strict mode without the two indexes refuses it)
#   legacy    always the date field: a document known to the month or the year only is found at the
#             first day of its period
# MOF_RAG_DATE_FILTER_MODE=auto
# auto mode: seconds the collection's answer (are the two indexes there?) is kept before it is read again
# by a date-bounded call (0-86400; 0 reads it before every date-bounded search). The longest the server
# takes to start using the intervals once the indexes are created, without a restart
# MOF_RAG_DATE_FILTER_REFRESH_S=300
# auto mode: seconds before a collection whose answer could not be read is read again (1-3600). Meanwhile
# date-bounded calls use the last answer read, or legacy when none was; such a failure refuses no call
# MOF_RAG_DATE_FILTER_RETRY_S=30

# Not read by the server, but by the libraries of the [rag] extra:
# The ONNX runtime sends usage events to its publisher (and keeps a device id under $HOME/.cache) unless
# this is 1. The server sets it to 1 for its own process when it is unset; set it here to make that
# explicit, or to 0 to allow the telemetry
# ORT_DISABLE_TELEMETRY=1
# Never ask huggingface.co for a model file. Recommended for the running service: with an incomplete
# model cache the server otherwise tries a download at every start. Leave it unset for the one-off fill
# HF_HUB_OFFLINE=1

# --- Result limits --------------------------------------------------------------------------------
# Rows per page when the caller gives no limit (>= 1, <= MOF_MCP_MAX_ROWS)
# MOF_MCP_DEFAULT_ROWS=50
# Largest limit a caller may ask for; a larger one is refused with [invalid_argument] (>= 1)
# MOF_MCP_MAX_ROWS=200
# Largest tool result in characters; a larger result is refused with [result_too_large], never cut (>= 1000)
# MOF_MCP_MAX_RESULT_CHARS=200000
# Error samples kept per row of vault_runs_status (>= 1)
# MOF_MCP_MAX_ERROR_SAMPLES=5
# Each error text in vault_runs_status is cut to this many characters (>= 1)
# MOF_MCP_MAX_TEXT_CHARS=2000

# --- No-vault mode: SEC data fetched live, filings indexed on this machine ([companies] + [filings]) --
# Where the companies toolset reads: auto (the store when MOF_COMPANIES_CATALOG is set, else SEC when
# MOF_SEC_CONTACT is set, else no companies toolset) | store (needs MOF_COMPANIES_CATALOG) | sec (needs MOF_SEC_CONTACT)
# MOF_COMPANIES_SOURCE=auto
# E-mail or name sent in the User-Agent of every request to SEC (their fair-access rules ask for it); printable ASCII, at most 200 characters; never logged
# MOF_SEC_CONTACT=<you@example.com>
# Requests per second to SEC: above 0, at most 10 (SEC's own limit)
# MOF_SEC_MAX_RPS=5.0
# Seconds one request to SEC may take (1-600)
# MOF_SEC_TIMEOUT_S=30
# Retries of a failed request to SEC (0-20; 0 = none)
# MOF_SEC_RETRIES=4
# Time budget in seconds of one tool call that fetches from SEC (1-3600)
# MOF_SEC_CALL_BUDGET_S=50
# Years before now whose facts get their filings' statement positions (three requests per filing) when a
# call names no period start (1-50); MOF_SEC_TTM_LOOKBACK_M moves that start further back
# MOF_SEC_POSITIONS_LOOKBACK_Y=5
# Earlier report filings looked through for the positions a filing without its own borrows, as the store's
# selection does (0-40; three requests each)
# MOF_SEC_POSITIONS_DONOR_DEPTH=4
# Months before the period's start (period_from, or the lookback's start without one) whose facts' filings
# also get positions, so the period's TTM and ratios equal the store's (0-120; 20 covers both
# MOF_COMPANIES_Q4_RULE values, 14 is enough for ytd9 alone)
# MOF_SEC_TTM_LOOKBACK_M=20
# Companies whose live tables are kept in memory; the oldest built is dropped first (1-10000)
# MOF_SEC_MEMO_COMPANIES=50
# Seconds a failed fetch of a company is remembered: calls meanwhile get its error at once (1-3600)
# MOF_SEC_FAILURE_TTL_S=60
# Seconds a call gives the auto-mode check of the store against SEC; companies not checked by then are
# answered by the store with reason freshness_unchecked; an SEC failure skips the check for MOF_SEC_FAILURE_TTL_S (1-600)
# MOF_SEC_FRESHNESS_BUDGET_S=5
# Keep fetched data between calls: on | off (off = entries live for the process only)
# MOF_CACHE=on
# Cache folder, absolute ('~' is not expanded); default = the platform's user cache folder + /myopenfund-mcp
# (~/.cache or $XDG_CACHE_HOME on Linux, ~/Library/Caches on macOS, %LOCALAPPDATA% on Windows)
# MOF_CACHE_DIR=<cache-dir>
# Size in GB of the cached HTTP bodies above which the oldest-written are removed (1-100000);
# the model files and the local index are on top of it and never removed
# MOF_CACHE_MAX_GB=20
# Fraction of MOF_CACHE_MAX_GB the cache is shrunk to when it is over the limit (above 0, at most 1)
# MOF_CACHE_EVICT_TO=0.9
# Seconds a temporary file of an interrupted write is kept before eviction removes it (60-86400)
# MOF_CACHE_TMP_GRACE_S=3600
# Hours a cached filing list is reused (1-8760)
# MOF_CACHE_TTL_SUBMISSIONS_H=24
# Hours a cached company-facts file is reused (1-8760)
# MOF_CACHE_TTL_COMPANYFACTS_H=24
# Filings downloaded and indexed by one call (1-1000)
# MOF_FILINGS_MAX_DOCS=40
# Passages companies_search_filings returns when the caller gives no limit (>= 1, <= MOF_FILINGS_SEARCH_MAX_LIMIT)
# MOF_FILINGS_SEARCH_DEFAULT_LIMIT=8
# Largest limit a caller may ask companies_search_filings for (1-1000)
# MOF_FILINGS_SEARCH_MAX_LIMIT=20
# Fetched filings a search without `companies` may cover; more = the caller must name companies (1-10000)
# MOF_FILINGS_SEARCH_MAX_DOCS=40
# Not-yet-ready documents listed in a search result; the others are only counted (0-1000)
# MOF_FILINGS_NOT_READY_LISTED=10
# Embedding workers of the filings indexer: batches embedded in parallel, one per document (1-32)
# MOF_INDEX_WORKERS=1
# Passages embedded and added in one step, the unit of the indexing order (1-1024; 32 = about 8-12 s on 4 CPU)
# MOF_INDEX_BATCH_SIZE=32
# Batches of the MD&A of each company's newest document indexed first, company after company (0-100; 0 = none)
# MOF_INDEX_FIRST_BATCHES=1
# Documents fetched and cut ahead of the embedding (1-1000; a company's newest one is always fetched ahead)
# MOF_INDEX_FETCH_AHEAD=24
# Seconds closing the filings indexer waits for its current step, a batch included (0-3600)
# MOF_INDEX_CLOSE_TIMEOUT_S=30
# Seconds `myopenfund-mcp warm` waits between two looks at its progress (above 0, at most 3600)
# MOF_WARM_POLL_INTERVAL_S=5.0
# Seconds without progress after which `warm` stops waiting, lists the stuck documents, exits 1 (1-604800)
# MOF_WARM_STALL_S=1800
# ONNX execution provider of the local embedding: cpu | coreml
# MOF_RAG_ONNX_PROVIDER=cpu
# Constant k of the reciprocal-rank fusion of a filings search (1-1000)
# MOF_SEARCH_RRF_K=60
# Passages each retriever hands to the fusion (1-1000)
# MOF_SEARCH_CANDIDATES=50
# Add the graph (eigenmind) retriever to a filings search: true | false. Off until an evaluation decides
# MOF_SEARCH_EIGENMIND=false
# Form types fetched when the caller names none, comma-separated
# MOF_FILINGS_DEFAULT_FORMS=10-K
# Largest passage of the local index, in tokens (16-8192)
# MOF_CHUNK_MAX_TOKENS=480
# Tokens shared by neighbouring passages (0-2048, below MOF_CHUNK_MAX_TOKENS)
# MOF_CHUNK_OVERLAP_TOKENS=32

# --- Deployment only (read by compose.example.yaml, not by the server) ----------------------------
# Host address the container port is published on: 127.0.0.1 (default) or a private interface's
# address. Never 0.0.0.0 on a host reachable from the internet.
# MOF_MCP_BIND_ADDR=127.0.0.1
# Host port the container port is published on
# MOF_MCP_BIND_PORT=8000
# Name of the vault stack's Docker network, when the MCP joins it (see compose.example.yaml)
# MOF_VAULT_DOCKER_NETWORK=<vault-network>
