# myopenfund-mcp configuration: environment variables only. Copy to .env (never committed) and fill in.
# Each variable is shown commented out with its default: an unset or empty variable takes that default.
# Uncomment only what you change. Keep MOF_MCP_TRANSPORT and MOF_MCP_HOST commented out for the Docker
# image (it sets http and 0.0.0.0 itself). A bad value stops the server at start, naming the variable.

# --- Transport -------------------------------------------------------------------------------------
# stdio (local, one client process, no token) | http (Streamable HTTP, bearer tokens required)
# MOF_MCP_TRANSPORT=stdio
# Interface the HTTP server listens on. Loopback by default; the Docker image sets 0.0.0.0 inside the
# container, and the compose port mapping decides what the host exposes.
# MOF_MCP_HOST=127.0.0.1
# HTTP port (1-65535)
# MOF_MCP_PORT=8000
# HTTP endpoint path (must start with /)
# MOF_MCP_PATH=/mcp

# --- Clients and tiers (http only) ---------------------------------------------------------------
# MOF_MCP_TRANSPORT=http requires MOF_MCP_TOKENS: the HTTP server never runs unauthenticated.
# One entry per client, comma-separated: client:sha256hex[:tier]   (tier read | act, default act)
# Client ids: 1-32 characters of A-Z a-z 0-9 _ . -
# Make each entry with:   myopenfund-mcp hash-token <client> [--tier read|act]
#   (container: docker compose run --rm mcp myopenfund-mcp hash-token <client>)
#   It GENERATES a random 256-bit token: the token is printed on stderr (give it to that client only),
#   the entry alone on stdout (paste it here). Only the digest is stored on the server. To revoke a
#   client, delete its entry and restart.
# Entropy: digests are unsalted SHA-256, safe only for random tokens like these. Never use a passphrase
# or any token you chose yourself (hash-token does not accept one).
# MOF_MCP_TOKENS=<client>:<sha256hex>:act,<other-client>:<sha256hex>:read

# --- Vault toolset (needs the [vault] extra) ------------------------------------------------------
# Unset = no vault toolset (server_info reports it "not configured"). Use the read-only role.
# Set sslmode explicitly (it also avoids a wasted SSL attempt per call):
#   verify-full  preferred: encrypts AND authenticates the server (add sslrootcert=<provider CA file>)
#   require      fallback: encrypts, but does NOT authenticate the server
#   disable      only on a trusted private network (same Docker network, VPN)
# MOF_VAULT_DATABASE_URL=postgresql://vault_readonly:<password>@<host>:5432/documents?sslmode=verify-full
# Seconds before a vault query is cancelled by Postgres (statement_timeout per call; 1-2147483)
# MOF_MCP_QUERY_TIMEOUT_S=20
# Seconds to wait for a Postgres connection (2-300)
# MOF_MCP_CONNECT_TIMEOUT_S=10

# --- Companies and datasets toolsets (needs the [companies] extra) --------------------------------
# Unset = no companies_* / datasets_* toolsets (server_info reports them "not configured"). Both
# MOF_COMPANIES_CATALOG and MOF_COMPANIES_DATA_ROOT must be set together. Use the read-only lake_reader role.
# my-open-data catalogue connection string (kept out of logs and repr)
# MOF_COMPANIES_CATALOG=postgres:dbname=<db> host=<host> port=5432 user=lake_reader password=<password>
# Folder holding lake/ as this host sees it (read-only is enough)
# MOF_COMPANIES_DATA_ROOT=<data-root>
# Seconds before a store call stops waiting (1-3600)
# MOF_COMPANIES_QUERY_TIMEOUT_S=20
# Most companies a single call may name (1-100)
# MOF_COMPANIES_MAX_COMPANIES=10
# Store reads running at once; a read that hit its time budget keeps its slot until it ends (1-16)
# MOF_COMPANIES_MAX_CONCURRENCY=2

# --- Result limits --------------------------------------------------------------------------------
# Rows per page when the caller gives no limit (>= 1, <= MOF_MCP_MAX_ROWS)
# MOF_MCP_DEFAULT_ROWS=50
# Largest limit a caller may ask for; a larger one is refused with [invalid_argument] (>= 1)
# MOF_MCP_MAX_ROWS=200
# Largest tool result in characters; a larger result is refused with [result_too_large], never cut (>= 1000)
# MOF_MCP_MAX_RESULT_CHARS=200000
# Error samples kept per row of vault_runs_status (>= 1)
# MOF_MCP_MAX_ERROR_SAMPLES=5
# Each error text in vault_runs_status is cut to this many characters (>= 1)
# MOF_MCP_MAX_TEXT_CHARS=2000

# --- Deployment only (read by compose.example.yaml, not by the server) ----------------------------
# Host address the container port is published on: 127.0.0.1 (default) or a private interface's
# address. Never 0.0.0.0 on a host reachable from the internet.
# MOF_MCP_BIND_ADDR=127.0.0.1
# Host port the container port is published on
# MOF_MCP_BIND_PORT=8000
# Name of the vault stack's Docker network, when the MCP joins it (see compose.example.yaml)
# MOF_VAULT_DOCKER_NETWORK=<vault-network>
